# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Database ---
# Local dev: matches the credentials in docker-compose.yml (run `docker compose up -d` first).
# In GitHub Actions this is instead set as a repo secret pointing at a Neon (or similar
# cloud) Postgres instance, since Actions runners can't reach localhost/Docker on your Mac.
DATABASE_URL=postgresql://job_ingest:job_ingest@localhost:5433/job_ingest

# --- Email digest (Resend) ---
# Get a free API key at https://resend.com after signing up.
RESEND_API_KEY=

# Sender address. Resend's shared sandbox domain works for a single-recipient digest
# without verifying your own domain; swap in a verified address if you set one up.
DIGEST_FROM_EMAIL=onboarding@resend.dev

# Where the daily digest gets sent.
DIGEST_TO_EMAIL=you@example.com
